# Database Configuration
DB_HOST=localhost
DB_NAME=ticket
DB_USER=root
DB_PASS=

# Application Configuration
APP_ENV=development
APP_DEBUG=true

# Base path override (optional)
# Leer lassen wenn Document Root direkt auf /public zeigt (z.B. IONOS mit Subdomain auf /public)
# APP_BASE_PATH=
APP_SECRET=CHANGE_ME_generate_with_php_bin2hex_random_bytes_32

# Tagesbericht (Cron) – Secret für den HTTP-Aufruf von /cron_report.php
# Leer lassen → HTTP-Aufruf ist deaktiviert (CLI/CRON via php-CLI funktioniert weiterhin).
# Empfehlung: zufälligen Wert generieren, z.B. mit `php -r "echo bin2hex(random_bytes(16));"`
REPORT_SECRET=
