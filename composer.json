{
    "name": "mind-building/openticket",
    "description": "Open-source ticketing system for theaters and event venues",
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.1",
        "monolog/monolog": "^3.0",
        "phpmailer/phpmailer": "^7.0",
        "setasign/fpdi": "^2.6",
        "tecnickcom/tcpdf": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/core",
            "app/models",
            "app/services",
            "app/helpers"
        ],
        "files": [
            "app/helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}
